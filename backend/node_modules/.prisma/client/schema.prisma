generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String
  password  String
  role      String   @default("usuario")
  status    String   @default("ativo")
  createdAt DateTime @default(now())

  receitas   Receita[]
  gastos     Gasto[]
  fixos      Fixo[]
  parcelados Parcelado[]
}

model Receita {
  id        String   @id @default(uuid())
  descricao String
  valor     Float
  data      String
  tipo      String
  obs       String   @default("")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gasto {
  id          String   @id @default(uuid())
  descricao   String
  valor       Float
  data        String
  categoria   String
  tipo        String
  pagamento   String
  obs         String   @default("")
  fixoId      String?
  parceladoId String?
  parcelNum   Int?
  monthKey    String?
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Fixo {
  id        String   @id @default(uuid())
  descricao String
  valor     Float
  categoria String
  pagamento String
  dia       Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Parcelado {
  id           String   @id @default(uuid())
  descricao    String
  valorTotal   Float
  valorParcela Float
  parcelas     Int
  mesInicio    String
  dia          Int
  categoria    String
  pagamento    String
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
